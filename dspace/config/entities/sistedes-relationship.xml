<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE relationships SYSTEM "relationship-types.dtd">

<relationships>

    <type>
        <leftType>Artículo</leftType>
        <rightType>Autor</rightType>
        <leftwardType>isAuthorOfPaper</leftwardType>
        <rightwardType>isPaperOfAuthor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>
    <type>
        <leftType>Resumen</leftType>
        <rightType>Autor</rightType>
        <leftwardType>isAuthorOfAbstract</leftwardType>
        <rightwardType>isAbstractOfAuthor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>
    <type>
        <leftType>Seminario</leftType>
        <rightType>Autor</rightType>
        <leftwardType>isAuthorOfSeminar</leftwardType>
        <rightwardType>isSeminarOfAuthor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>
    <!--
    Relationships below are not really used, but the initialize-entities script (which registers the entities)
    expects that entities have relationships in order to be added in the database
    Entities below are only specified in one direction, since we don't expect to navigate from
    Authors to Bulletins or Minutes
    -->
    <type>
        <leftType>Boletín</leftType>
        <rightType>Autor</rightType>
        <leftwardType>isAuthorOfBulletin</leftwardType>
        <rightwardType>isBulletinOfAuthor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>false</copyToLeft>
    </type>
    <type>
        <leftType>Acta</leftType>
        <rightType>Autor</rightType>
        <leftwardType>isAuthorOfMinutes</leftwardType>
        <rightwardType>isMinutesOfAuthor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>false</copyToLeft>
    </type>
</relationships>
